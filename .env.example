# Public browser configuration. Use a separate development Supabase project.
VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_DEV_PUBLISHABLE_KEY
# Optional: must match the server's VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=
# Enable only after the cafe-member projection has been reviewed and installed.
VITE_CAFE_MEMBER_LIST_ENABLED=false
VITE_CAFE_WAVES_ENABLED=false
VITE_SAFE_CHAT_ENABLED=false
# Enable after Google OAuth credentials and allowed redirects are configured in Supabase.
VITE_GOOGLE_SIGN_IN_ENABLED=false
VITE_REPORTS_ENABLED=false

# Never put service-role, Google/Apple, Stripe or Lovable secrets in VITE_*.
# Opt-in stress test configuration belongs in the process environment:
# RUN_PRESENCE_STRESS=1
# PRESENCE_TEST_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
# PRESENCE_TEST_SUPABASE_KEY=YOUR_TEST_PUBLISHABLE_KEY

# Manual selfie comparison; enable only after reviewed backend activation.
VITE_ACCOUNT_VERIFICATION_ENABLED=false

# Enable after same-cafe photo backend activation.
VITE_CAFE_PHOTOS_ENABLED=false
