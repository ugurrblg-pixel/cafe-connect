{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["scripts/places/**/*.ts", "supabase/functions/_shared/placeDirectory.ts", "supabase/functions/_shared/placeAdapters.ts"]
}
